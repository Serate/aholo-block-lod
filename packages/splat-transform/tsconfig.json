{
  "extends": "@internal/utils/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "strictPropertyInitialization": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": false,
    "types": ["node"],
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true
  },
  "include": ["./src"],
  "exclude": ["**/dist", "node_modules/**"]
}
